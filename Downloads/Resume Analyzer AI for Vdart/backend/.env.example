# Copy this file to the project root as .env and fill in your values.
# cp backend/.env.example ../.env
#
# IMPORTANT: If secrets were previously exposed, rotate ALL values below
# before deploying to production.

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000

# ── Backend Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_me

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_USERNAME=replace_me
ADMIN_PASSWORD=replace_me

# ── AI Services (optional — app works in mock mode without these) ─────────────
LOVABLE_API_KEY=replace_me
FIRECRAWL_API_KEY=replace_me
AI_GATEWAY_URL=https://ai.gateway.resume.dev/v1/chat/completions
AI_MODEL=google/gemini-2.5-flash

# ── Supabase (frontend only — publishable/anon key, not a service role key) ───
SUPABASE_URL=replace_me
SUPABASE_PROJECT_ID=replace_me
SUPABASE_PUBLISHABLE_KEY=replace_me
VITE_SUPABASE_URL=replace_me
VITE_SUPABASE_PROJECT_ID=replace_me
VITE_SUPABASE_PUBLISHABLE_KEY=replace_me
